# NetBox MCP Server Configuration
# Copy this file to .env and customize for your environment

# ===== Core NetBox Configuration (REQUIRED) =====
NETBOX_URL=https://netbox.example.com/
NETBOX_TOKEN=your_api_token_here

# ===== Transport Configuration =====
# Options: stdio (default, for Claude Desktop/Code) or http (for web clients)
TRANSPORT=stdio

# ===== HTTP Transport Settings =====
# Only used when TRANSPORT=http
HOST=127.0.0.1
PORT=8000

# ===== Security Settings =====
# Set to false only for testing with self-signed certificates
VERIFY_SSL=true
CORS_ORIGINS='["http://localhost:6274"]'

# Bearer token required on the HTTP endpoint (unset = unauthenticated).
# Required when ENABLE_WRITE=true and TRANSPORT=http; the server won't start without it.
# MCP_AUTH_TOKEN=

# Extra text for the instructions clients get when they connect (after the built-in ones)
# MCP_INSTRUCTIONS="This NetBox is the source of truth for IP addresses and DNS names."

# ===== Branch-Only Write Mode =====
# Adds tools that create/update/delete objects inside NetBox Branching branches only,
# never in main. Needs the netbox-branching plugin and a write-capable NETBOX_TOKEN.
ENABLE_WRITE=false
# Also allow writes into branches owned by other users (default: only your own)
ALLOW_FOREIGN_BRANCHES=false
# Event rules (webhooks, scripts) and subscriber notifications fire for branch changes too;
# writes are refused while any enabled rule covers a branchable type, or anyone is subscribed
# to a branchable object, unless this is true. Rules with the condition
# {"and": [{"attr": "active_branch", "value": null}]} only fire on main and don't block, if
# NetBox's EVENTS_PIPELINE runs netbox_branching.events.add_branch_context before
# extras.events.process_event_queue (see README)
ALLOW_BRANCH_EVENTS=false
# ...or allow only specific rules (comma-separated event rule IDs)
# ALLOWED_BRANCH_EVENT_RULES=12,15
# Confirm the token's user views everything without permission constraints (e.g. a
# superuser); the event rule, bookmark, subscription and job checks refuse until this is true
UNRESTRICTED_TOKEN=false
# NetBox < 4.5 only: the API token's username (newer NetBox reports it itself)
# NETBOX_USERNAME=

# ===== Logging Configuration =====
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
